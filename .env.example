# Local development defaults; published ports bind only to localhost.
AEGIS_DB_PASSWORD=aegis_local
AEGIS_API_TOKEN=aegis-local-dev
AEGIS_HTTP_PORT=8000
AEGIS_POSTGRES_PORT=5433
AEGIS_DASHBOARD_PORT=8080
# Approval preparation is disabled until both distinct credentials are set.
# Keep both different from AEGIS_API_TOKEN. No default approval credentials.
AEGIS_APPROVAL_REQUEST_TOKEN=
AEGIS_APPROVAL_REVIEW_TOKEN=
AEGIS_APPROVAL_REVIEWER=local-reviewer
# Optional reviewed execution role, distinct from all credentials above.
AEGIS_APPROVAL_EXECUTION_TOKEN=
AEGIS_APPROVAL_EXECUTOR=local-executor
