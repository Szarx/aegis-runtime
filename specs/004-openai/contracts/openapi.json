      },
      "TraceList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TraceSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
